# ==========================================
# CYCLONEX ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# -----------------
# FRONTEND (Vite / Vercel)
# -----------------
# For Local Dev: http://localhost:8000
# For Production: https://your-public-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000

# -----------------
# NODE BACKEND (Express / Render)
# -----------------
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,https://cyclone-x-delta.vercel.app

# Internal or public URL to Python ML service
# Local: http://127.0.0.1:8001
# Production (Render private or internal service): http://cyclonex-ml:8001 or https://cyclonex-ml.onrender.com
ML_SERVICE_URL=http://127.0.0.1:8001

# -----------------
# PYTHON ML & COPERNICUS SERVICE (FastAPI / Render)
# -----------------
PORT=8001
# Path to PyTorch model checkpoint (.zip or .pt)
MODEL_PATH=C:/path/to/best_model.zip
# Optional: Public direct download URL to fetch model if missing from disk
MODEL_DOWNLOAD_URL=

# Copernicus Marine Service Credentials (BACKEND ONLY - NEVER COMMIT OR EXPOSE AS VITE_*)
# Register free at: https://data.marine.copernicus.eu/
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
