# ==========================================
# CYCLONEX DEPLOYMENT ENVIRONMENT VARIABLES
# ==========================================

# -----------------
# FRONTEND (VERCEL)
# -----------------
# Define the URL of your Render backend so the frontend knows where to fetch data
VITE_API_BASE_URL=https://your-render-backend-url.onrender.com

# -----------------
# BACKEND (RENDER)
# -----------------
# Define the domain of your frontend to secure CORS (No trailing slash)
FRONTEND_ORIGIN=https://your-vercel-domain.vercel.app

# Optional port for local dev
PORT=8000
